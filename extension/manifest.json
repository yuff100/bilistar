{
  "manifest_version": 3,
  "name": "只看关注",
  "version": "0.5.0",
  "description": "B 站浏览器插件：首页、空间、视频与稿件页只保留关注内容。",
  "content_scripts": [
    {
      "matches": ["https://*.bilibili.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "https://*.bilibili.com/*",
    "https://api.bilibili.com/*"
  ]
}
